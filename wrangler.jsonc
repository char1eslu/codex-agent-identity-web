{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-agent-identity-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  }
}
